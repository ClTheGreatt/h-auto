// H-Auto: Online Smart Gardening Monitoring System
// Database schema for capstone project
//
// Stack: PostgreSQL + Prisma ORM
// Run after editing: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FACULTY
  STUDENT_FARMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CropStatus {
  ACTIVE
  ARCHIVED
}

enum PlotStatus {
  PREPARING
  PLANTED
  GROWING
  READY_FOR_HARVEST
  HARVESTED
  FALLOW
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  RETIRED
}

enum AlertType {
  LOW_SOIL_MOISTURE
  HIGH_SOIL_MOISTURE
  LOW_TEMPERATURE
  HIGH_TEMPERATURE
  LOW_HUMIDITY
  HIGH_HUMIDITY
  LOW_LIGHT
  HIGH_LIGHT
  LOW_NITROGEN
  HIGH_NITROGEN
  LOW_PHOSPHORUS
  HIGH_PHOSPHORUS
  LOW_POTASSIUM
  HIGH_POTASSIUM
  DEVICE_OFFLINE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationChannel {
  SMS
  IN_APP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

enum ImportType {
  FACULTY
  STUDENT_FARMER
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ReportType {
  PLOT_ENVIRONMENTAL
  PLOT_GROWTH
  PLOT_FULL
  CROP_PERFORMANCE
  ALERTS_SUMMARY
  ASSIGNMENT_SUMMARY
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  middleName   String?
  lastName     String
  phoneNumber  String?  @unique
  role         UserRole
  idNumber     String?    @unique // student number OR employee number
  department   String?    // for faculty
  course       String?    // for students
  yearLevel    String?    // for students
  section      String?    // for students
  academicYear String?    // for students — entry cohort, e.g. "2023-2024"
  position     String?    // for faculty
  profileImage String?
  status       UserStatus @default(ACTIVE)
  // Graduation is orthogonal to `status`: a graduated student isn't
  // "inactive", they're a completed student whose historical data must stay
  // intact. Null means not graduated. Checked at the same revocation
  // checkpoints as tokenVersion (see auth.ts / mobile-auth.ts) so existing
  // sessions/tokens stop working the moment this is set.
  graduatedAt  DateTime?
  lastLoginAt  DateTime?
  tourCompletedAt DateTime?
  // Bumped on password change or status change to INACTIVE.
  // Existing JWTs/sessions carry the tokenVersion at issue time; a mismatch
  // against the current DB value invalidates that session immediately.
  tokenVersion Int        @default(0)
  // True for newly created accounts (temp password must be rotated before
  // the dashboard is reachable). Existing accounts were backfilled to false
  // by the migration that added this column.
  mustChangePassword Boolean @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  facultyAssignments  PlotAssignment[]    @relation("FacultyAssignments")
  studentAssignments  PlotAssignment[]    @relation("StudentAssignments")
  createdAssignments  PlotAssignment[]    @relation("AssignmentCreator")
  advisedPlots        Plot[]              @relation("PlotAdviser")
  advisories          FacultySectionAdvisory[] @relation("FacultyAdvisories")
  growthLogs          GrowthLog[]
  reports             Report[]
  importBatches       ImportBatch[]
notifications       AlertNotification[]
  pushTokens          PushToken[]

  @@index([role])
  @@index([status])
  @@index([academicYear, section])
}

// Many-to-many: a faculty member can advise multiple sections, and a
// section may be co-advised by more than one faculty member.
model FacultySectionAdvisory {
  id        String   @id @default(cuid())
  facultyId String
  section   String
  createdAt DateTime @default(now())

  faculty   User     @relation("FacultyAdvisories", fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([facultyId, section])
  @@index([section])
}

// ============================================================
// CROPS & GROWTH STAGES
// ============================================================

model Crop {
  id             String      @id @default(cuid())
  name           String      @unique
  variety        String?
  description    String?
  imageUrl       String?
  daysToHarvest  Int
  cultivationGuide String?   @db.Text
  status         CropStatus  @default(ACTIVE)
  archivedAt     DateTime?
  // Promotes this crop into the "Custom" group of the Add-crop Quick start
  // dropdown, alongside the hard-coded built-in presets. Never set
  // automatically — an admin opts a crop in explicitly via togglePreset().
  isPreset       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  stages CropStage[]
  plots  Plot[]

  @@index([status])
  @@index([isPreset])
}

model CropStage {
  id           String @id @default(cuid())
  cropId       String
  name         String // e.g. "Germination", "Vegetative", "Flowering", "Harvest"
  orderIndex   Int
  durationDays Int
  description  String?

  // Ideal thresholds for this stage
  minSoilMoisture  Float
  maxSoilMoisture  Float
  minTemperature   Float
  maxTemperature   Float
  minHumidity      Float
  maxHumidity      Float
  minLightIntensity Float
  maxLightIntensity Float
  minNitrogen      Float
  maxNitrogen      Float
  minPhosphorus    Float
  maxPhosphorus    Float
  minPotassium     Float
  maxPotassium     Float

  crop          Crop        @relation(fields: [cropId], references: [id], onDelete: Cascade)
  currentPlots  Plot[]      @relation("CurrentStage")
  growthLogs    GrowthLog[]

  @@unique([cropId, orderIndex])
  @@index([cropId])
}

// ============================================================
// PLOTS & ASSIGNMENTS
// ============================================================

model Plot {
  id              String     @id @default(cuid())
  name            String
  location        String?
  sizeSqm         Float?
  cropId          String?
  currentStageId  String?
  facultyId       String?
  plantingDate    DateTime?
  expectedHarvest DateTime?
  status          PlotStatus @default(PREPARING)
  archivedAt      DateTime?
  harvestedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  crop          Crop?            @relation(fields: [cropId], references: [id])
  currentStage  CropStage?       @relation("CurrentStage", fields: [currentStageId], references: [id])
  adviser       User?            @relation("PlotAdviser", fields: [facultyId], references: [id])
  device        Device?
  assignments   PlotAssignment[]
  sensorReadings SensorReading[]
  alerts        Alert[]
  growthLogs    GrowthLog[]

  @@index([cropId])
  @@index([status])
  @@index([facultyId])
}

model PlotAssignment {
  id           String           @id @default(cuid())
  plotId       String
  facultyId    String
  studentId    String
  assignedAt   DateTime         @default(now())
  endedAt      DateTime?
  status       AssignmentStatus @default(ACTIVE)
  notes        String?
  // Who clicked "Assign" — an admin, a super admin, or the adviser
  // themselves. Distinct from facultyId, which is always the plot's
  // adviser regardless of who performed the action. Nullable/SetNull on
  // purpose: existing rows predate this column (never backfilled with a
  // guess), and deleting a user must not block or cascade-delete
  // historical assignments.
  assignedById String?

  plot       Plot  @relation(fields: [plotId], references: [id], onDelete: Cascade)
  faculty    User  @relation("FacultyAssignments", fields: [facultyId], references: [id])
  student    User  @relation("StudentAssignments", fields: [studentId], references: [id])
  assignedBy User? @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([plotId])
  @@index([facultyId])
  @@index([studentId])
  @@index([status])
}

// ============================================================
// IOT: DEVICES & SENSOR READINGS
// ============================================================

model Device {
  id          String       @id @default(cuid())
  deviceCode  String       @unique // physical device identifier
  plotId      String       @unique
  // Plaintext key, kept only for the lazy-migration fallback in
  // /api/sensors/ingest — do not read this for new auth logic. Slated for
  // removal once all devices are confirmed backfilled onto apiKeyHash.
  apiKey      String       @unique // for authenticating ESP32 POSTs
  // SHA-256 hex digest of apiKey. Deterministic (unlike bcrypt) so the
  // unique-indexed findUnique lookup ingest relies on still works in O(1);
  // SHA-256 is appropriate here because apiKey is 48 hex chars of
  // crypto-random entropy (randomBytes(24)), not a human-chosen password —
  // there's nothing for bcrypt's deliberate slowness to protect against.
  apiKeyHash  String?      @unique
  firmwareVersion String?
  lastSeenAt  DateTime?
  status      DeviceStatus @default(OFFLINE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  plot     Plot            @relation(fields: [plotId], references: [id], onDelete: Cascade)
  readings SensorReading[]
}

model SensorReading {
  id             String   @id @default(cuid())
  deviceId       String
  plotId         String   // denormalized for fast plot-scoped queries
  recordedAt     DateTime @default(now())
  soilMoisture   Float?   // percentage
  temperature    Float?   // celsius
  humidity       Float?   // percentage
  lightIntensity Float?   // lux
  nitrogen       Float?   // mg/kg
  phosphorus     Float?   // mg/kg
  potassium      Float?   // mg/kg

  device Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  plot   Plot    @relation(fields: [plotId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([plotId, recordedAt])
  @@index([deviceId, recordedAt])
}

// ============================================================
// ALERTS & NOTIFICATIONS
// ============================================================

model Alert {
  id        String        @id @default(cuid())
  plotId    String
  readingId String?
  type      AlertType
  severity  AlertSeverity @default(WARNING)
  message   String
  resolved  Boolean       @default(false)
  resolvedAt DateTime?
  createdAt DateTime      @default(now())

  suggestionTitle String?
  suggestionSteps String[] @default([])

  plot         Plot                @relation(fields: [plotId], references: [id], onDelete: Cascade)
  reading      SensorReading?      @relation(fields: [readingId], references: [id])
  notifications AlertNotification[]

  @@index([plotId, createdAt])
  @@index([resolved])
}

model AlertNotification {
  id                String              @id @default(cuid())
  alertId           String
  userId            String
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([alertId])
}

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique // Expo push token: ExponentPushToken[xxxx]
  platform   String?  // "ios" | "android"
  deviceName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// MONITORING: GROWTH LOGS & IMAGES
// ============================================================

model GrowthLog {
  id            String   @id @default(cuid())
  plotId        String
  userId        String
  stageId       String?
  plantHeightCm Float?
  leafCount     Int?

  // Sensor snapshot at time of logging (Option A — immutable)
  soilMoisture    Float?
  temperature     Float?
  humidity        Float?
  lightIntensity  Float?
  nitrogen        Float?
  phosphorus      Float?
  potassium       Float?
  sensorReadingId String?

  observations  String?  @db.Text
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  plot   Plot          @relation(fields: [plotId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])
  stage  CropStage?    @relation(fields: [stageId], references: [id])
  images GrowthImage[]

  @@index([plotId, createdAt])
}

model GrowthImage {
  id          String   @id @default(cuid())
  growthLogId String
  imageUrl    String
  caption     String?
  createdAt   DateTime @default(now())

  growthLog GrowthLog @relation(fields: [growthLogId], references: [id], onDelete: Cascade)
}

// ============================================================
// REPORTS & IMPORTS
// ============================================================

model Report {
  id         String     @id @default(cuid())
  userId     String
  type       ReportType
  title      String
  params     Json       // date range, plot IDs, crop IDs, etc.
  fileUrl    String?
  fileFormat String?    // "pdf" | "xlsx" | "csv"
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ImportBatch {
  id            String       @id @default(cuid())
  userId        String
  type          ImportType
  fileName      String?
  totalRows     Int
  successCount  Int          @default(0)
  failureCount  Int          @default(0)
  errorLog      Json?
  status        ImportStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
