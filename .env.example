# ============================================================================
# H-Auto Environment Variables
# ============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Free Neon tier works: https://neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ─── Authentication (NextAuth v5) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Or in PowerShell: [Convert]::ToBase64String((1..32 | %{ Get-Random -Max 256 }))
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Set to `true` for local development. Required for non-HTTPS environments.
AUTH_TRUST_HOST="true"

# Your app's URL. Use http://localhost:3000 for local; your domain in production.
AUTH_URL="http://localhost:3000"

# ─── Cloudinary (image hosting for growth logs) ──────────────────────────────
# Sign up free: https://cloudinary.com — get values from Dashboard → Settings
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Semaphore (SMS alerts — Philippine carrier) ─────────────────────────────
# Sign up: https://semaphore.co — needs credits for real SMS
# For local development without sending real SMS, use: test_mock_key
SEMAPHORE_API_KEY="test_mock_key"

# ─── Resend (email notifications) ────────────────────────────────────────────
# Sign up: https://resend.com — free 3,000 emails/month, 100/day
# Use default sender `onboarding@resend.dev` for testing without domain setup
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"
EMAIL_FROM_NAME="H-Auto Smart Gardening"